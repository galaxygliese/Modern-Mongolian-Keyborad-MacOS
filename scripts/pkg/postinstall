#!/bin/bash
# Runs as root after the .pkg copies the bundle to /Library/Keyboard Layouts.
# Turns the keyboards on for the logged-in user so nothing is left to configure.
BUNDLE="/Library/Keyboard Layouts/ModernMongolian.bundle"
user="$(stat -f %Su /dev/console)"
if [[ -z "$user" || "$user" == "root" || "$user" == "loginwindow" ]]; then
  exit 0
fi
home="$(dscl . -read "/Users/$user" NFSHomeDirectory | awk '{print $2}')"
# A per-user copy from install.sh would show every keyboard twice.
rm -rf "$home/Library/Keyboard Layouts/ModernMongolian.bundle"
uid="$(id -u "$user")"
launchctl asuser "$uid" sudo -u "$user" \
  osascript -l JavaScript "$(dirname "$0")/tis.js" enable "$BUNDLE" || true
exit 0
